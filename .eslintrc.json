{
  "env": {
    "browser": true,
    "es2020": true,
    "serviceworker": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "globals": {
    "supabase": "readonly",
    "SimplePeer": "readonly",
    "QRCode": "readonly",
    "Chart": "readonly",
    "jspdf": "readonly",
    "html2canvas": "readonly",
    "emailjs": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-console": "off",
    "semi": ["warn", "always"],
    "no-debugger": "warn"
  }
}
