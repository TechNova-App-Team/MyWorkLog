# ─────────────────────────────────────────────
# MyWorkLog .gitignore
# ─────────────────────────────────────────────
# Regel: alles, was nicht zur Production-PWA gehört
# oder Secrets/internes Wissen leaken könnte → raus.
# ─────────────────────────────────────────────

# ─── Secrets & Env ────────────────────────────
.env
.env.*
*.env
secrets.json
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
credentials.json
service-account*.json
firebase-adminsdk*.json
# Cloudflare Worker lokale Secrets / wrangler State
.wrangler/
.dev.vars
wrangler.toml.local

# ─── Dependencies ─────────────────────────────
node_modules/
jspm_packages/
bower_components/
.npm
.yarn/
.pnp.*

# ─── Build / Cache / Coverage ─────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/
.turbo/
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ─── Logs ─────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ─── Test-Artefakte ───────────────────────────
tests/
TESTING.md
*.test.js
*.spec.js
jest.config.js
junit.xml
playwright-report/
test-results/

# ─── IDE / Editor ─────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
.idea_modules/
*.iml
*.sublime-project
*.sublime-workspace
.vscode-test/
.history/
*.swp
*.swo
*~

# ─── OS-Cruft ─────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ─── Backups & Tempfiles ──────────────────────
*.bak
*.backup
*_backup*
*.old
*.orig
*.tmp
*.temp
*.rej
.~lock.*

# ─── KI-Assistenten / Workspace-Configs ───────
# CLAUDE.md enthält interne Projekt-Konventionen
# und ist nichts für die Public.
.claude/
CLAUDE.md
.cursor/
.cursorrules
.aider*
.github/copilot/

# ─── Interne Dev-Tools (nicht für End-User) ───
# Python-Scripts, die nur lokal laufen
dead_storage_hunter.py
repo-tracker.py
*.pyc
__pycache__/
.python-version
.venv/
venv/

# ─── Interne Doku & Reports ───────────────────
# Internes Wissen, Roadmaps, Reviews — nichts für public
SECURITY-FIX.md
SECURITY-AUDIT*.md
TODO.md
NOTES.md
SCRATCH.md
ROADMAP*.md
# Interne READMEs (Workdocs)
README´s/

# ─── DB / SQL / Migrations ────────────────────
# RLS-Policies und Schemas leaken Backend-Logik
DB/
*.sql
*.sqlite
*.sqlite3
*.db

# ─── Backups vom localStorage / Exports ───────
tg_pro_data*.json
tg_pro_data*.txt
backup_*.json
export_*.json

# ─── Persoenliche Notizen (bleiben lokal) ─────
# Ideen-/Backlog-Sammlung, nicht fuers oeffentliche Repo.
# Achtung: gitignored heisst auch "git checkout holt sie NICHT zurueck".
/IDEEN.txt

# ─── Sonstiges ────────────────────────────────
.eslintignore
.prettierignore
.vagrant/
.docker/
docker-compose.override.yml

# ─── Cloudflare Worker (NIEMALS committen) ────
# Repo ist ÖFFENTLICH. Worker-Quellcode bleibt lokal.
workers/

# ─── GENERIERTE ARTEFAKTE ─────────────────────
# Werden beim Deploy von Cloudflare aus den Quellen gebaut (npm run build).
# Nicht committen — sonst laege der Code doppelt im Repo.
#
# ⚠️ Der fuehrende Slash ist PFLICHT: "index.html" wuerde auch saemtliche
#    pages/*/index.html erschlagen (alle 16 Standalone-Seiten!).
# ⚠️ KEINE Inline-Kommentare hinter dem Pattern — .gitignore kennt die nicht,
#    das "#" wird Teil des Patterns und die Regel greift stillschweigend nicht.

# gebaut aus index.template.html + components/**/*.html
/index.html

# gebaut aus den deutschen Quellen + tools/i18n/dict/
/pages/en/

# Lokal bauen: npm run build:index  (laeuft auch als postinstall)

# ─── graphify (Code-Wissensgraph, lokales Werkzeug) ────────
# graph.html/graph.json sind eine vollstaendige Karte des Quellcodes und rund
# 5 MB gross. Cloudflare Pages liefert ALLES aus, was im Repo liegt — committed
# waere der Graph also unter myworklog.de/graphify-out/ oeffentlich abrufbar.
# Der Ordner wird lokal aus dem Code erzeugt (`graphify update .`) und gehoert
# damit ohnehin nicht ins Repo.
/graphify-out/

# ─── Hier NICHT ignorieren (Whitelist) ────────
# Falls obige Patterns zu breit greifen:
!Rechtliches/SECURITY.md
!Rechtliches/PRIVACY.md
!README.md

# Local Codex instructions/configuration
AGENTS.md
.codex/

# Lokale Demo-/Testdatei, nicht fuer GitHub
WEATHER_DEMO.txt
notes.txt

# Frueher standen hier 22 Junctions, die pages/* unter ihren Clean-URL-Namen
# in den Projektstamm gespiegelt haben, damit der lokale Server /berichtsheft/
# findet. Die Liste war handgepflegt: jede neue Seite brauchte eine Zeile,
# und ohne die haette `git add -A` denselben Inhalt ein zweites Mal committet.
# Portman kann das inzwischen selbst (mode "overlay:pages" in sites.conf plus
# _redirects) - im Projekt liegt dafuer nichts mehr herum.

# Screenshots, die im Projektwurzel-Verzeichnis abgelegt werden (z.B. zum Zeigen im Chat)
/image.png
/image*.png

# Code-Bericht: erzeugt tools/repo-report.mjs in `npm run build`.
# Bauartefakt wie index.html und pages/en/, kein Quelltext.
pages/repo-report/index.html
# Rohausgabe des alten Python-Skripts, falls es noch jemand startet.
/repo-report.html
