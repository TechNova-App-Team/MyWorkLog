# ─────────────────────────────────────────────
# MyWorkLog .gitignore
# ─────────────────────────────────────────────

# ─── Secrets & Env ────────────────────────────
.env
.env.*
*.env
secrets.json
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
credentials.json
.wrangler/
.dev.vars
wrangler.toml.local

# ─── Dependencies ─────────────────────────────
node_modules/
.npm

# ─── Build / Cache / Coverage ─────────────────
dist/
build/
out/
.cache/
coverage/
.nyc_output/
.eslintcache
.stylelintcache

# ─── Logs ─────────────────────────────────────
*.log
logs/
npm-debug.log*

# ─── Test-Artefakte ───────────────────────────
tests/
TESTING.md
*.test.js
*.spec.js
jest.config.js
junit.xml
test-results/

# ─── IDE / Editor ─────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
.idea_modules/
*.iml
*.sublime-project
*.sublime-workspace
.vscode-test/
.history/
*.swp
*.swo
*~

# ─── OS-Cruft ─────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ─── Backups & Tempfiles ──────────────────────
*.bak
*.backup
*_backup*
*.old
*.orig
*.tmp
*.temp
*.rej
.~lock.*

# ─── KI-Assistenten / Workspace-Configs ───────
.claude/
CLAUDE.md
.cursor/
.cursorrules
.aider*
.github/copilot/

# ─── Interne Dev-Tools (nicht für End-User) ───
dead_storage_hunter.py
repo-tracker.py
*.pyc
__pycache__/
.python-version
.venv/
venv/

# ─── Interne Doku & Reports ───────────────────
SECURITY-FIX.md
SECURITY-AUDIT*.md
TODO.md
NOTES.md
SCRATCH.md
ROADMAP*.md

# ─── DB / SQL / Migrations ────────────────────
# RLS-Policies und Schemas leaken Backend-Logik
DB/
*.sql
*.sqlite
*.sqlite3
*.db

# ─── Backups vom localStorage / Exports ───────
tg_pro_data*.json
tg_pro_data*.txt
backup_*.json
export_*.json

# ─── Persoenliche Notizen (bleiben lokal) ─────
# Achtung: gitignored heisst auch "git checkout holt sie NICHT zurueck".
/IDEEN.txt

# ─── Sonstiges ────────────────────────────────
.eslintignore
.prettierignore

# ─── Cloudflare Worker (NIEMALS committen) ────
# Repo ist ÖFFENTLICH. Worker-Quellcode bleibt lokal.
workers/

# ─── GENERIERTE ARTEFAKTE ─────────────────────
# Nicht committen — sonst laege der Code doppelt im Repo.
# ⚠️ Der fuehrende Slash ist PFLICHT: "index.html" wuerde auch saemtliche
#    pages/*/index.html erschlagen (alle 16 Standalone-Seiten!).
# ⚠️ KEINE Inline-Kommentare hinter dem Pattern — .gitignore kennt die nicht,
#    das "#" wird Teil des Patterns und die Regel greift stillschweigend nicht.
/index.html
/pages/en/

# ─── graphify (Code-Wissensgraph) ─────────────
# Wird lokal erzeugt und ist rund 5 MB gross. Cloudflare liefert alles aus,
# was im Repo liegt — der Graph waere sonst oeffentlich abrufbar.
/graphify-out/

# ─── Hier NICHT ignorieren (Whitelist) ────────
!Rechtliches/SECURITY.md
!Rechtliches/PRIVACY.md
!README.md

# Local Codex instructions/configuration
AGENTS.md
.codex/

# Lokale Dateien, Demos und Notizen, nicht fuer GitHub
/Lokales/

# Screenshots, die im Projektwurzel-Verzeichnis abgelegt werden
/image.png
/image*.png

# Code-Bericht: Bauartefakt, kein Quelltext.
pages/repo-report/index.html
# Rohausgabe des alten Python-Skripts, falls es noch jemand startet.
/repo-report.html

deploy.ps1