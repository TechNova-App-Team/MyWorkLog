## Cloudflare Pages Cache-Control Headers

# HTML — short cache, must revalidate (SPA, changes often)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# JS & CSS assets — MUST revalidate. Filenames sind NICHT gefingerprinted,
# d.h. Inhalt ändert sich unter gleichem Namen. "immutable" wäre fatal:
# Browser würden 1 Jahr lang alte Dateien servieren ohne je nachzufragen.
# max-age=0 + must-revalidate = Browser fragt mit ETag, kriegt 304 (billig)
# wenn unverändert, 200 mit neuem Content nach Deploy.
/Assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/Assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/components/*
  Cache-Control: public, max-age=0, must-revalidate

# Config files — short cache
/config/*
  Cache-Control: public, max-age=0, must-revalidate

# Images / icons
/Grafiken/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Fonts — immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Manifest & Service Worker — no cache
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# ========================================================
# Dev-/Internal-File-Patterns — niemals cachen.
# Spiegelt die Block-Liste in _redirects, damit alte
# Browser-Caches die 404 nicht selbst weiter-cachen.
# ========================================================
/*.py
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*.sh
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*.bak
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*.log
  Cache-Control: no-store
  X-Robots-Tag: noindex

/*.env
  Cache-Control: no-store
  X-Robots-Tag: noindex

/.env
  Cache-Control: no-store
  X-Robots-Tag: noindex
