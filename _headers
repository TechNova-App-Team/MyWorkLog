## Cloudflare Pages Headers

# ========================================================
# Security Headers (alle Seiten)
# ========================================================
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

# ========================================================
# Cache-Control Headers
# ========================================================

# HTML — short cache, must revalidate (SPA, changes often)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# JS & CSS assets — MUST revalidate. Filenames sind NICHT gefingerprinted,
# d.h. Inhalt ändert sich unter gleichem Namen. "immutable" wäre fatal:
# Browser würden 1 Jahr lang alte Dateien servieren ohne je nachzufragen.
# max-age=0 + must-revalidate = Browser fragt mit ETag, kriegt 304 (billig)
# wenn unverändert, 200 mit neuem Content nach Deploy.
/Assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/Assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/components/*
  Cache-Control: public, max-age=0, must-revalidate

# Config files — short cache
/config/*
  Cache-Control: public, max-age=0, must-revalidate

# Images / icons
/Grafiken/*
  Cache-Control: public, max-age=31536000, immutable

# Das Intro-Video liegt im selben Ordner und wird unter gleichem Namen ersetzt.
# Eine eigene Regel dafuer stand hier kurz — sie hat NICHT ueberstimmt: Pages
# merged bei mehreren Treffern, live kam `max-age=86400, immutable,
# must-revalidate` heraus (der max-age stammt zusaetzlich aus einer Regel im
# Cloudflare-Dashboard, siehe Kommentar in tools/stamp-assets.js). Ein Wert, der
# gleichzeitig immutable und must-revalidate sagt, hilft niemandem.
# Geloest wird es stattdessen ueber die URL: stamp-assets haengt ?v=<version>
# an die Video-Referenz, damit ist jede Fassung eine eigene Adresse — und dann
# ist `immutable` fuer sie sogar korrekt.

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Fonts — immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Manifest & Service Worker — no cache
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

