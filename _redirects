# ========================================================
# 0. SECURITY BLOCKS — Dev-/Internal-Files niemals ausliefern.
#    Greift VOR allen anderen Regeln (erste passende Regel gewinnt).
#    Auch wenn so eine Datei versehentlich im Deploy landet: 404.
# ========================================================

/*.py        /404.html  404
/*.sh        /404.html  404
/*.bak       /404.html  404
/*.log       /404.html  404
/*.tmp       /404.html  404
/*.env       /404.html  404
/.env        /404.html  404
/.env.*      /404.html  404
/.git/*      /404.html  404
/.gitignore  /404.html  404
/.gitattributes /404.html 404
/.eslintrc*  /404.html  404
/.vscode/*   /404.html  404
/.idea/*     /404.html  404
/CLAUDE.md   /404.html  404
/SECURITY-FIX.md /404.html 404

# ========================================================
# 1. 301 REDIRECTS (Alte HTML-Pfade & Trailing Slashes auf Clean URLs)
# ========================================================

/pages/berichtsheft.html /berichtsheft 301
/berichtsheft/ /berichtsheft 301
/pages/aufgaben.html /aufgaben 301
/aufgaben/ /aufgaben 301
/pages/fahrtkosten.html /fahrtkosten 301
/fahrtkosten/ /fahrtkosten 301
/pages/vertrags-manager.html /vertrags-manager 301
/vertrags-manager/ /vertrags-manager 301
/pages/rechte-checker.html /rechte-checker 301
/rechte-checker/ /rechte-checker 301
/pages/skill-tree.html /skill-tree 301
/skill-tree/ /skill-tree 301
/pages/repo-report.html /repo-report 301
/repo-report/ /repo-report 301
/pages/analytics.html /analytics 301
/analytics/ /analytics 301
/pages/Impressum.html /Impressum 301
/Impressum/ /Impressum 301
/pages/DSGVO.html /DSGVO 301
/DSGVO/ /DSGVO 301
/pages/about.html /about 301
/about/ /about 301

# ========================================================
# 2. 200 REWRITES (Clean URLs intern auf echte HTML-Dateien mappen)
# ========================================================

/berichtsheft /pages/berichtsheft.html 200
/aufgaben /pages/aufgaben.html 200
/fahrtkosten /pages/fahrtkosten.html 200
/vertrags-manager /pages/vertrags-manager.html 200
/rechte-checker /pages/rechte-checker.html 200
/skill-tree /pages/skill-tree.html 200
/repo-report /pages/repo-report.html 200
/analytics /pages/analytics.html 200
/Impressum /pages/Impressum.html 200
/DSGVO /pages/DSGVO.html 200
/about /pages/about.html 200
/archflow /pages/archflow/index.html 200
/archflow/archflow-data.js /pages/archflow/archflow-data.js 200

# ========================================================
# 3. ENGLISH /en/ (statische i18n-Pipeline → pages/en/<name>/index.html)
#    Trailing-Slash 301 auf Clean-URL, dann interner 200-Rewrite auf die Datei.
#    Homepage /en/ läuft über die Cloudflare-Dashboard-Rewrite-Regel.
# ========================================================

/en/about/ /en/about 301
/en/about /pages/en/about/index.html 200