/jest.config.js /404.html 302
/babel.config.js /404.html 302
/WEATHER_DEMO.txt /404.html 302

# ========================================================
# 1. CLEAN URLs - Canonical ist die Form MIT Schraegstrich.
#
#    Jede Seite traegt <link rel="canonical" href=".../<name>/"> und steht so
#    auch in der sitemap.xml. Hier stand bis 2026-08-16 die Gegenrichtung
#    (/berichtsheft/ -> /berichtsheft 301), also ein 301 WEG vom Canonical.
#
#    Gegriffen hat das nie: eine Rewrite-Regel im Cloudflare-Dashboard faengt
#    die Slash-Form vorher ab und liefert sie mit 200 aus. Die Form OHNE
#    Schraegstrich fiel dagegen hier durch - und weil ein 200-Rewrite auf ein
#    Verzeichnis (/pages/<name>/index.html) von Cloudflare zu einem sichtbaren
#    308 auf eben diesen Pfad normalisiert wird, stand danach der interne
#    /pages/-Pfad in der Adresszeile. Gemessen am 2026-08-16: /berichtsheft,
#    /archflow, /Fachinformatiker, /en/about - alle 308 auf /pages/...
#
#    Deshalb hier kein 200-Rewrite mehr, sondern ein 301 auf den Canonical.
#    Ein Rewrite kann diese Datei bei Cloudflare Pages ohnehin nur auf eine
#    echte Datei, nicht auf ein Verzeichnis (siehe archflow-data.js unten).
# ========================================================

/about                           /about/                          301
/analytics                       /analytics/                      301
/archflow                        /archflow/                       301
