{
  "name": "MyWorkLog",
  "version": "3.13.1",
  "description": "Eine moderne TimeTracking und Fortschritts-App.",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint *.js",
    "dev": "npm run test:watch",
    "build": "echo 'App is ready, no build step needed'",
    "i18n:build": "node tools/i18n/build-all.js",
    "i18n:extract": "node tools/i18n/i18n-build.js extract index.html tools/i18n/dict/index.de.json",
    "postinstall": "git config core.hooksPath tools/git-hooks || true",
    "geo:build": "node --stack-size=8000 tools/geo/build-maps.js"
  },
  "keywords": [
    "timetracker",
    "zeiterfassung",
    "timer",
    "local",
    "ausbildung"
  ],
  "author": "TechNova App Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^29.1.1"
  }
}
