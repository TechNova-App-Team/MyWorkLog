{
  "name": "MyWorkLog",
  "version": "7.4.13",
  "description": "Eine moderne TimeTracking und Fortschritts-App.",
  "main": "index.html",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "lint": "eslint *.js",
    "build": "node tools/build-index.js && node tools/stamp-assets.js && node tools/i18n/build-all.js && node tools/stamp-assets.js && node tools/repo-report.mjs && node tools/strip-comments.js && node tools/prune-deploy.js",
    "i18n:build": "node tools/i18n/build-all.js",
    "i18n:extract": "node tools/i18n/i18n-build.js extract index.html tools/i18n/dict/index.de.json",
    "postinstall": "git config core.hooksPath tools/git-hooks || true",
    "geo:build": "node --stack-size=8000 tools/geo/build-maps.js",
    "build:index": "node tools/build-index.js",
    "build:index:check": "node tools/build-index.js --check",
    "stats": "node tools/count-stats.js",
    "archflow": "node tools/archflow.js .",
    "i18n:untranslated": "node tools/i18n/untranslated.js",
    "graph:publish": "node tools/publish-graph.js",
    "test:all": "node tools/run-tests.mjs",
    "b2b:e2e": "node tools/b2b-e2e.mjs",
    "check:live": "node tools/live-check.mjs",
    "check:pfade": "node tools/asset-pfade.test.mjs",
    "repo:report": "node tools/repo-report.mjs",
    "repo:history": "node tools/repo-history.mjs",
    "wartung": "node tools/wartung.mjs",
    "perf": "node tools/perf.mjs",
    "shot": "node tools/screenshot.mjs"
  },
  "keywords": [
    "timetracker",
    "zeiterfassung",
    "timer",
    "local",
    "ausbildung"
  ],
  "author": "TechNova App Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.52.0"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "jsdom": "^29.1.1"
  }
}
