#!/bin/sh
# ═══ AUTO-BUILD HOOK ═══
# Drei generierte Artefakte werden hier automatisch erzeugt und mit-committed:
#   1. index.html   ← index.template.html + components/<x>/<x>.html   (build-index)
#   2. ?v=-Stempel  ← config/version.json                             (stamp-assets)
#   3. /en/-Seiten  ← deutsche Quellen + Dicts                        (i18n:build)
#
# REIHENFOLGE IST KRITISCH: build-index → stamp → i18n → stamp.
#   • build-index zuerst: index.html existiert im frischen Checkout (Cloudflare) gar nicht.
#   • stamp danach: stempelt index.html UND index.template.html. Nur das Artefakt zu
#     stempeln reicht nicht — der nächste Rebuild würde die ?v= aus dem Template zurückholen.
#   • i18n nach build-index, weil es /en/ per jsdom aus der fertigen index.html backt.
#   • stamp am Ende nochmal: der i18n-Renderer injiziert i18n-runtime.js ungestempelt.
#
# Aktiviert via: git config core.hooksPath tools/git-hooks (läuft als npm postinstall).

changed=$(git diff --cached --name-only --diff-filter=ACM)
# pages/en/* ist GENERIERTE Ausgabe → ausschließen, sonst triggert sich der Hook selbst
sources=$(echo "$changed" | grep -vE '^pages/en/')

# ═══ GUARD: index.html ist GENERIERT ═══
# Wer sie direkt editiert, verliert die Änderung beim nächsten Build. Lieber hier
# abbrechen als still überschreiben.
if echo "$sources" | grep -qE '^index\.html$'; then
  if ! echo "$sources" | grep -qE '^(index\.template\.html|components/.*\.html|config/version\.json)$'; then
    if ! node tools/build-index.js --check; then
      echo ""
      echo "[build-index] ✗ index.html wurde direkt bearbeitet — Commit abgebrochen."
      echo "              Diese Datei ist GENERIERT. Deine Änderung ginge beim nächsten"
      echo "              Build verloren. Bearbeite stattdessen:"
      echo "                • components/<name>/<name>.html  (Views, Sidebar, Modals)"
      echo "                • index.template.html            (Head, Shell, Script-Tags)"
      exit 1
    fi
  fi
fi

# ═══ 1. INDEX-BUILD ═══
# Idempotent: schreibt nur, wenn sich wirklich etwas ändert.
if ! node tools/build-index.js; then
  echo "[build-index] ✗ Build fehlgeschlagen — Commit abgebrochen."
  exit 1
fi

# ═══ 2. ASSET-STAMPING ═══
# Cloudflare liefert /Assets/* mit max-age=86400 aus (Dashboard-Regel, NICHT _headers).
# Ohne Versions-Query im HTML sehen Nutzer nach einem Deploy bis zu 24h altes JS/CSS.
if echo "$sources" | grep -qE '^config/version\.json'; then
  echo "[stamp] Version gebumpt → stemple Asset-URLs …"
  if ! node tools/stamp-assets.js; then
    echo "[stamp] ✗ Stamping fehlgeschlagen — Commit abgebrochen."
    exit 1
  fi
  git add index.template.html components pages 2>/dev/null
fi

git add index.html 2>/dev/null

# index.html kann durch Stamping/Build gerade erst dazugekommen sein → neu einlesen
changed=$(git diff --cached --name-only --diff-filter=ACM)
sources=$(echo "$changed" | grep -vE '^pages/en/')

# ═══ 3. i18n /en/ ═══
echo "$sources" | grep -qE '^(index\.html|pages/|tools/i18n/dict/)' || exit 0

if [ ! -d node_modules/jsdom ]; then
  echo "[i18n] WARNUNG: jsdom fehlt (führe 'npm install' aus) — /en/ NICHT regeneriert."
  exit 0
fi

echo "[i18n] deutsche Quelle geändert → regeneriere /en/ …"
if ! npm run --silent i18n:build; then
  echo "[i18n] ✗ Build fehlgeschlagen — Commit abgebrochen. Fehler oben prüfen."
  exit 1
fi

# Der i18n-Build generiert /en/ aus der deutschen Quelle neu — die Stempel wandern
# dabei mit. Danach nochmal drueber, damit auch frisch erzeugte Dateien sauber sind.
node tools/stamp-assets.js > /dev/null 2>&1

# frisch generierte Artefakte mit einstagen (EN-Seiten liegen unter pages/en/*,
# weil die Cloudflare-Rewrite-Regel /en/ intern auf /pages/en/ mappt)
git add pages/en Assets/i18n 2>/dev/null
echo "[i18n] ✓ /en/ aktualisiert und mit-committed."
exit 0
