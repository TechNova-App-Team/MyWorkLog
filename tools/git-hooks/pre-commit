#!/bin/sh
# ═══ PRE-COMMIT: bauen & validieren ═══
#
# index.html und pages/en/ sind GENERIERTE Artefakte und stehen in .gitignore.
# Gebaut werden sie beim Deploy von Cloudflare (`npm run build`). Dieser Hook
# baut sie LOKAL, damit du sie im Browser testen kannst — und validiert, dass
# der Cloudflare-Build gelingen wird.
#
# Warum die Validierung wichtig ist: Weil /en/ nicht mehr im Repo liegt, sieht
# niemand mehr im Diff, wenn eine Uebersetzung fehlt. Der Hook bricht deshalb ab,
# sobald der i18n-Build auch nur EINEN fehlenden Key meldet — sonst ginge
# deutscher Text still auf die englische Seite live.
#
# Aktiviert via: git config core.hooksPath tools/git-hooks (laeuft als npm postinstall).

changed=$(git diff --cached --name-only --diff-filter=ACM)

# ═══ 1. INDEX-BUILD ═══
# Immer — idempotent, schreibt nur bei echter Aenderung. Haelt die lokale
# index.html mit index.template.html + components/**/*.html in Sync.
if ! node tools/build-index.js; then
  echo "[build-index] ✗ Build fehlgeschlagen — Commit abgebrochen."
  echo "              Pruefe die @include-Marker in index.template.html."
  exit 1
fi

# ═══ 2. ASSET-STAMPING ═══
# Cloudflare liefert /Assets/* mit max-age=86400 aus (Dashboard-Regel, NICHT _headers).
# Ohne Versions-Query im HTML sehen Nutzer nach einem Deploy bis zu 24h altes JS/CSS.
# Stempelt index.template.html (die QUELLE!) — nur das Artefakt zu stempeln brächte
# nichts, der naechste Rebuild wuerde es ueberschreiben.
if echo "$changed" | grep -qE '^config/version\.json'; then
  echo "[stamp] Version gebumpt → stemple Asset-URLs …"
  if ! node tools/stamp-assets.js; then
    echo "[stamp] ✗ Stamping fehlgeschlagen — Commit abgebrochen."
    exit 1
  fi
  # stamp-assets gleicht auch package.json an config/version.json an
  git add index.template.html components pages package.json 2>/dev/null
  node tools/build-index.js > /dev/null   # index.html mit frischen Stempeln neu bauen
fi

# ═══ 3. i18n-VALIDIERUNG ═══
# Nur wenn eine deutsche Quelle oder ein Dict angefasst wurde.
echo "$changed" | grep -qE '^(index\.template\.html|components/|pages/|tools/i18n/dict/)' || exit 0

if [ ! -d node_modules/jsdom ]; then
  echo "[i18n] WARNUNG: jsdom fehlt (npm install) — /en/ NICHT validiert."
  exit 0
fi

echo "[i18n] deutsche Quelle geändert → /en/ bauen & prüfen …"
out=$(npm run --silent i18n:build 2>&1)
status=$?

if [ $status -ne 0 ]; then
  echo "$out" | tail -20
  echo "[i18n] ✗ Build fehlgeschlagen — Commit abgebrochen."
  exit 1
fi

# "0 fehlend" ist gut, alles andere ist untranslated Text auf der Live-Seite.
if echo "$out" | grep -qE '[1-9][0-9]* fehlend'; then
  echo ""
  echo "$out" | grep -E '[1-9][0-9]* fehlend|fehlende Keys'
  echo ""
  echo "[i18n] ✗ Fehlende Übersetzungen — Commit abgebrochen."
  echo "       Auf /en/ stünde an dieser Stelle deutscher Text."
  echo "       Fix: node tools/i18n/i18n-build.js extract pages/<seite>/index.html \\"
  echo "                 tools/i18n/dict/<seite>.de.json"
  echo "            → git diff auf das Dict → jeden neuen Key in <seite>.en-overrides.json"
  echo "              übersetzen (bzw. in <seite>.phrases.en.json bei gemischtem Inhalt)."
  exit 1
fi

# Assets/i18n/* sind Build-Zwischenstände und bleiben getrackt.
# index.html + pages/en/ NICHT einstagen — die stehen in .gitignore und
# werden von Cloudflare gebaut.
git add Assets/i18n 2>/dev/null
echo "[i18n] ✓ /en/ gebaut, 0 fehlende Übersetzungen."
exit 0
